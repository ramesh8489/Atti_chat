# Backend Environment Variables Template (Placeholders Only)
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://atti_user:atti_secret_placeholder@localhost:5432/atti_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id-placeholder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-placeholder@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----\n"

# WebRTC STUN/TURN
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=your-coturn-hmac-secret-placeholder
TURN_TTL_SECONDS=86400

# S3 Private Object Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=atti-media-storage-placeholder
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key-placeholder
VAPID_PRIVATE_KEY=your-vapid-private-key-placeholder
VAPID_SUBJECT=mailto:support@pingup.app
