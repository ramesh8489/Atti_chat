# ==============================================================================
# PingUp Backend Production Environment Template
# NEVER commit production .env with real credentials to source control!
# ==============================================================================

# Server & Network
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://pingup.yourdomain.com

# PostgreSQL Production Connection (Enable SSL mode for hosted databases)
DATABASE_URL="postgresql://pingup_user:STRONG_SECURE_PASSWORD@postgres.yourdomain.com:5432/pingup_prod?schema=public&sslmode=require"

# Redis Production Connection (Require authentication and TLS if remote)
REDIS_ENABLED=true
REDIS_URL="redis://:REDIS_AUTH_PASSWORD@redis.yourdomain.com:6379"

# Firebase Admin Service Account (Obtained from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID="your-production-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-production-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_SECURE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# WebRTC STUN & TURN Infrastructure (RFC 5766 Time-Limited Ephemeral Credentials)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_SERVER_URL="turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp"
TURN_SECRET="GENERATE_A_64_CHAR_HEX_SECRET_FOR_COTURN_HMAC_SHA1"
TURN_TTL_SECONDS=86400

# Private S3-Compatible Object Storage (AWS S3, Cloudflare R2, or DigitalOcean Spaces)
S3_ENDPOINT="" # Leave empty for AWS S3 default; or specify e.g. "https://<account_id>.r2.cloudflarestorage.com"
S3_BUCKET="pingup-production-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"

# Web Push Notifications (RFC 8292 VAPID)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:security@yourdomain.com"

