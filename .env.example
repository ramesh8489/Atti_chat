# ==============================================================================
# Atti Environment Variables Template (Placeholders Only - No Real Secrets)
# Copy this file to .env before starting services
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
POSTGRES_USER=atti_user
POSTGRES_PASSWORD=atti_secret_placeholder
POSTGRES_DB=atti_db
DATABASE_URL=postgresql://atti_user:atti_secret_placeholder@localhost:5432/atti_db?schema=public

# Redis Distributed Presence & Scaling
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Firebase Admin Configuration (For Backend ID-Token Verification)
FIREBASE_PROJECT_ID=your-firebase-project-id-placeholder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-placeholder@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# WebRTC STUN & TURN Infrastructure Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_USERNAME=placeholder_turn_user
TURN_CREDENTIAL=placeholder_turn_credential
TURN_SECRET=placeholder_turn_hmac_secret

# S3-Compatible Private Object Storage Configuration
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=atti-media-storage-placeholder
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key_placeholder
S3_SECRET_ACCESS_KEY=your_s3_secret_key_placeholder
