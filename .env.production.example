# ==============================================================================
# PingUp Docker Compose Production Environment Template
# ==============================================================================

# Domain & Network
CORS_ORIGIN=https://pingup.yourdomain.com
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=/

# PostgreSQL Production Container Config
POSTGRES_USER=pingup_admin
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=pingup_production

# Redis Production Container Config
REDIS_PASSWORD=GENERATE_STRONG_RANDOM_REDIS_PASSWORD

# Firebase Admin Credentials
FIREBASE_PROJECT_ID=your-production-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-production-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Firebase Frontend Client Config
VITE_FIREBASE_API_KEY=AIzaSyProductionKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-production-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-production-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-production-firebase-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# S3 Private Object Storage
S3_BUCKET=pingup-production-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY

# Coturn TURN Configuration
TURN_REALM=turn.yourdomain.com
TURN_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_COTURN
TURN_SERVER_URL="turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp"
TURN_TTL_SECONDS=86400
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# Web Push VAPID
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT="mailto:security@yourdomain.com"

